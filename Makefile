CXX = mpicxx
DBGFLAGS = -g -fomit-frame-pointer
#OPTFLAGS = $(DBGFLAGS) -O3 -DPRINT_EXTRA_NEDGES #-DDEBUG_PRINTF   
OPTFLAGS = -O3 -DPRINT_EXTRA_NEDGES #-DFAST_CHECK_EDGELIST -DUSE_SHMEM_ORDER #-DUSE_SHMEM_ORDER -DUSE_SHMEM_SIGNAL -DUSE_MPI_RMA_PASSIVE#-DDEBUG_PRINTF   
# -DPRINT_EXTRA_NEDGES prints extra edges when -p <> is passed to 
#  add extra edges randomly on a generated graph
# use export ASAN_OPTIONS=verbosity=1 to check ASAN output
SNTFLAGS = -std=c++2a -fsanitize=address -O1 -fno-omit-frame-pointer
CXXFLAGS = --std=c++20 $(OPTFLAGS) -I.

OBJ = main.o
TARGET = tric

all: $(TARGET)


ENABLE_SHMEM=0
ifeq ($(ENABLE_SHMEM), 1)
CXX = CC
LDFLAGS += -L/opt/cray/pe/pmi/6.1.11/lib -lpmi -lpmi2 
endif

ENABLE_CUDA=1
ifeq ($(ENABLE_CUDA),1)
NVCXX = nvcc
MPI_PATH = /share/apps/openmpi/5.0.7-cuda12.9.1/gcc/14.2.0
CUDA_PATH = /share/apps/cuda/12.9.1
CXXFLAGS += -DUSE_CUDA_IPC #-DUSE_CG_CLUSTER_GROUP #-DUSE_SINGLE_DEVICE -DSHOW_GRAPH_STATS -DSET_VERTEX_RANGE_SPLIT -DUSE_CUDA_WMMA_PREFETCH #-DUSE_ASYNC_MEMCPY #-DSET_VERTEX_RANGE_SPLIT#-DUSE_CUDA_IPC_MPI #-DSET_VERTEX_RANGE_SPLIT # #-DUSE_SPLIT_KERNELS-DUSE_ASYNC_MEMCPY #-DUSE_PIPELINED_MEMCPY #-DUSE_SPLIT_KERNELS -DMAX_CUDA_STREAMS=64 #-DSORT_BY_NUM_EDGES  #-DSET_VERTEX_RANGE #-DUSE_ASYNC_STREAMS_AT_RECV -DSPLIT_LOCAL_COUNTING_KERNEL# -DUSE_SPLIT_KERNELS # # ## #  -DSHOW_GRAPH_STATS # #-DUSE_CUDA_IPC  -DUSE_CUDA_AWARE_MPI#-DUSE_ASYNC_STREAMS_AT_RECV -DMASKED_LOCAL_COUNTING_KERNEL -DLESS_GLOBALMEM_READS #-DSEPARATE_LOCAL_COUNTING_KERNEL#-DMASKED_LOCAL_COUNTING_KERNEL #-DUSE_CUDA_CG -DLESS_GLOBALMEM_READS -DMASKED_LOCAL_COUNTING_KERNEL -DLESS_GLOBALMEM_READS #-DSEPARATE_LOCAL_COUNTING_KERNEL -DLESS_GLOBALMEM_READS#-DUSE_CUDA_CG# -DSEPARATE_LOCAL_COUNTING_KERNEL -DCOMBINED_LOCAL_COUNTING_KERNEL  #-DUSE_CUDA_CG 
CUDA_CXXFLAGS = -arch=sm_90 --ptxas-options=-v --use_fast_math -gencode arch=compute_90,code=sm_90 #--maxrregcount 100 -DCUDA_SET_L2_CACHE_GRANULARITY -DCUDA_SET_L2_CACHE_LIMIT  
#OMP_CXXFLAGS = -DUSE_OPENMP -fopenmp
INCLUDE += -I$(MPI_PATH)/include -I$(CUDA_PATH)/include #-DCALC_WARP_OCCUPANCY 
LDFLAGS += -lm -lrt -ldl -L$(MPI_PATH)/lib -lmpi -L$(CUDA_PATH)/lib64 -lcudart
OBJ += counting.o
endif

ENABLE_OPENMP=0
ifeq ($(ENABLE_OPENMP),1)
CXXFLAGS += -fopenmp -DUSE_OPENMP
endif

ENABLE_TAUPROF=0
ifeq ($(ENABLE_TAUPROF),1)
TAU=/people/ghos167/builds/tau-2.32/x86_64/lib
CXX = tau_cxx.sh -tau_makefile=$(TAU)/Makefile.tau-mpi-openmp-mpit
endif

%.o: %.cpp
ifeq ($(ENABLE_CUDA),1)
	$(NVCXX) $(INCLUDE) $(CXXFLAGS) $(CUDA_CXXFLAGS) -c counting.cu
	$(CXX) $(INCLUDE) $(OMP_CXXFLAGS) $(CXXFLAGS) -c -o $@ $^
else
	$(CXX) $(INCLUDE) $(CXXFLAGS) -c -o $@ $^
endif

$(TARGET):  $(OBJ)
	$(CXX) $(CXXFLAGS) $(OMP_CXXFLAGS) $(LDFLAGS) -o $@ $^ 


.PHONY: clean

clean:
	rm -rf *~ $(OBJ) $(TARGET) *.o *.dSYM
